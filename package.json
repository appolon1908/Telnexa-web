{
  "name": "telnexa-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.x",
    "npm": "11.17.x"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "validate": "node scripts/validate-contracts.mjs && node scripts/validate-compliance.mjs",
    "validate:production-compliance": "node scripts/validate-compliance.mjs --production",
    "test": "node --test tests/**/*.test.mjs",
    "test:smoke": "node scripts/smoke-local.mjs",
    "check": "npm run validate && npm test && npm run build"
  },
  "dependencies": {
    "nuxt": "4.5.2"
  }
}
