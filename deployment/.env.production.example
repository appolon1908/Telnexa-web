# Immutable images only. Replace both values with approved registry digests.
TELNEXA_WEB_IMAGE=ghcr.io/appolon1908-hue/telnexa-web@sha256:REPLACE_WITH_APPROVED_DIGEST
KONG_IMAGE=kong@sha256:REPLACE_WITH_APPROVED_DIGEST

NUXT_PUBLIC_SITE_URL=https://telnexa.co
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_PORTAL_URL=https://app.telnexa.co
NUXT_PUBLIC_STATUS_URL=https://status.telnexa.co
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_ENVIRONMENT=production
NUXT_PUBLIC_RELEASE_SHA=REPLACE_WITH_MERGED_SHA

# Private Nuxt runtime configuration. The browser never receives these values.
NUXT_MIDDLEWARE_BASE_URL=https://10.40.0.1:8443
NUXT_MIDDLEWARE_SERVICE_TOKEN=REPLACE_IN_SERVER_SECRET_STORE
NUXT_DEV_FORM_SINK_ENABLED=false

# Capability freeze. These values are recorded for deployment evidence and must remain false.
LIVE_SMS_DELIVERY=false
LIVE_EMAIL_DELIVERY=false
LIVE_PSTN_DIALING=false
ENABLE_PROVIDER_SUBMISSION=false
ENABLE_AUTOMATIC_PROVISIONING=false
ODOO_DIRECT_PUBLIC_ACCESS=false
N8N_DIRECT_PUBLIC_ACCESS=false
